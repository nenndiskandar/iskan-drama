{
  "name": "narto-drama",
  "version": "1.0.0",
  "description": "Narto Drama — short drama streaming frontend with Node.js/Express API relay (Pocket Tailwind skin)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "build:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/styles.css --watch"
  },
  "keywords": [
    "streaming",
    "drama",
    "short-drama",
    "tailwind",
    "ejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "@tailwindcss/forms": "^0.5.7"
  }
}
