<!DOCTYPE html>
<html lang="<%= lang || 'en-US' %>" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="">
  <title><%= typeof title !== 'undefined' ? title : 'Narto Drama' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Watch short dramas, mini series and anime with Bahasa Indonesia subtitles. Free streaming from BiliTV, CubeTV, DotDrama, DramaBox, and more.' %>">
  <meta name="robots" content="index,follow,max-image-preview:large">

  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : 'https://narto-drama.com/' %>">

  <!-- Tailwind compiled CSS -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <script defer src="/js/main.js"></script>
</head>
<body class="font-body bg-pocket-bg text-pocket-text-primary min-h-screen flex flex-col">

  <%- include('../components/header', { lang: lang || 'en-US' }) %>

  <main class="flex-grow container mx-auto px-3 py-4 md:py-6">
    <%- body %>
  </main>

  <%- include('../components/footer', { lang: lang || 'en-US' }) %>

</body>
</html>
