<div class="space-y-6">
  <!-- Active provider label -->
  <% if (typeof providerLabel !== 'undefined' && providerLabel) { %>
    <div class="flex items-center justify-between mb-2">
      <h1 class="text-xl font-bold text-white">
        <%= providerLabel %> <span class="text-pocket-text-secondary font-normal text-sm"></span>
      </h1>
    </div>
  <% } else { %>
    <h1 class="text-xl font-bold text-white mb-4">Latest Short Drama</h1>
  <% } %>

  <!-- Movies grid: flat list (allMovies merged from sections) -->
  <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
      <% movies.forEach(function(movie) { %>
        <%- include('../components/movie-card', { movie: movie }) %>
      <% }) %>
    </div>

    <!-- Pagination -->
    <%- include('../components/pagination', { pagination: pagination, currentPage: currentPage, provider: (typeof provider !== 'undefined' ? provider : ''), lang: lang }) %>

  <% } else { %>
    <!-- Empty state -->
    <div class="text-center py-12">
      <img src="/images/empty.png" alt="" class="mx-auto h-24 opacity-30">
      <p class="mt-4 text-pocket-text-secondary">Tidak ada drama ditemukan. Coba provider lain.</p>
    </div>
  <% } %>
</div>
