<div class="grid xl:grid-cols-[2fr_300px] gap-6">
  <!-- Player -->
  <div class="space-y-4">
    <% const currentEp = typeof currentEp !== 'undefined' ? currentEp : 1; %>
    <div class="bg-black rounded-lg overflow-hidden shadow-2xl shadow-pocket-accent/20">
      <% if (movie.external_url) { %>
        <!-- Playback note: Narto Drama does not expose a direct MP4/stream URL via its public
             API. The external_url points to narto's provider-import page which renders the
             upstream player behind Cloudflare. We surface it in an iframe so the user lands
             in the provider context; a real HLS/MP4 would require authenticated provider scraping,
             which is outside the scope of this proxy frontend. -->
        <iframe
          src="<%= movie.external_url %>"
          class="w-full"
          style="height: 60vh; min-height: 320px;"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          referrerPolicy="no-referrer-when-downgrade"
        ></iframe>
      <% } else { %>
        <div class="flex items-center justify-center h-[320px] bg-pocket-card rounded-lg border border-pocket-border">
          <p class="text-pocket-text-secondary">No playable source available.</p>
        </div>
      <% } %>
    </div>

    <div class="flex items-center justify-between text-sm text-pocket-text-secondary">
      <span>Episode <%= currentEp %> of <%= episodes.length %></span>
      <a href="/detail/watch/<%= movie.id %>" class="text-pocket-accent hover:text-white">Back to Detail</a>
    </div>
  </div>

  <!-- Episode list (sidebar) -->
  <div>
    <h3 class="text-lg font-semibold text-white mb-3">Episodes</h3>
    <div class="max-h-[500px] overflow-y-auto pr-2 space-y-1">
      <% episodes.forEach(function(ep) { %>
        <a href="/watch/<%= movie.id %>?ep=<%= ep.ep %>&lang=<%= lang %>"
            class="block px-3 py-2 text-sm rounded hover:bg-pocket-accent hover:text-white transition-colors <%= ep.ep === currentEp ? 'bg-pocket-accent text-white' : 'border border-pocket-border bg-pocket-card' %>">
          Episode <%= ep.ep %>
        </a>
      <% }) %>
    </div>
  </div>
</div>
