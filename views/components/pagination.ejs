<%
  // pagination.ejs
  // expects: pagination { current, total, next, prev }, currentPage, provider (optional), lang
  const p = pagination || {};
  const cur = currentPage || p.current || 1;
  const total = p.total || 1;
  if (total <= 1) return;
  const base = provider ? ('/provider/' + provider) : '/';
  function pagerUrl(pg) {
    let u = base + '?';
    if (pg && pg > 1) u += 'page=' + pg;
    u += (pg && pg > 1 ? '&' : '') + 'lang=' + (lang || 'en-US');
    return u;
  }
%>
<nav class="mt-6 flex items-center justify-center space-x-2">
  <!-- Prev -->
  <% if (cur > 1) { %>
    <a href="<%= pagerUrl(cur - 1) %>" class="px-3 py-2 rounded bg-pocket-card border border-pocket-border text-pocket-text-primary hover:bg-pocket-accent hover:text-white transition-colors">
      &laquo; Prev
    </a>
  <% } %>

  <!-- Page numbers (windowed) -->
  <div class="flex items-center space-x-1">
    <% const start = Math.max(1, cur - 2); const end = Math.min(total, start + 4); %>
    <% if (start > 1) { %>
      <a href="<%= pagerUrl(1) %>" class="px-3 py-2 rounded text-pocket-text-secondary hover:text-pocket-accent">1</a>
      <% if (start > 2) { %><span class="px-1 text-pocket-text-secondary">…</span><% } %>
    <% } %>
    <% for (let i = start; i <= end; i++) { %>
      <a href="<%= pagerUrl(i) %>" class="px-3 py-2 rounded <%= i === cur ? 'bg-pocket-accent text-white' : 'bg-pocket-card border border-pocket-border text-pocket-text-primary hover:bg-pocket-accent hover:text-white' %> transition-colors">
        <%= i %>
      </a>
    <% } %>
    <% if (end < total) { %>
      <% if (end < total - 1) { %><span class="px-1 text-pocket-text-secondary">…</span><% } %>
      <a href="<%= pagerUrl(total) %>" class="px-3 py-2 rounded text-pocket-text-secondary hover:text-pocket-accent"><%= total %></a>
    <% } %>
  </div>

  <!-- Next -->
  <% if (cur < total) { %>
    <a href="<%= pagerUrl(cur + 1) %>" class="px-3 py-2 rounded bg-pocket-card border border-pocket-border text-pocket-text-primary hover:bg-pocket-accent hover:text-white transition-colors">
      Next &raquo;
    </a>
  <% } %>
</nav>
